# TrueTaste mobile environment variables
# Copy this file to .env and fill in your values.

# Base URL of the TrueTaste Express backend.
# Use your computer's LAN IP (e.g. http://192.168.1.10:5000) when running on a
# physical device with Expo Go. "localhost" only works for web / simulators.
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Google Maps API key (optional - used for directions deep links)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=