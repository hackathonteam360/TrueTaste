PORT=5000
# MongoDB connection string. Local example below; replace with your Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/truetaste
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary (optional - seed/mobile fall back to placeholder images when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI provider (optional - the server falls back to a Mock AI when unset)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Allowed origins for CORS (comma separated)
CLIENT_ORIGIN=http://localhost:8081